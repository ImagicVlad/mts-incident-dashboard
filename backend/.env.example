# Leave empty to use the synthetic dataset. Relative paths start at backend/.
INCIDENTS_FILE=
DISPLAY_TIMEZONE=Europe/Moscow
WATCH_POLLING=false
ITSM_URL_TEMPLATE=
DEMO_LOGIN=coordinator.demo
DEMO_PASSWORD=mts-demo-local
# An Argon2 encoded hash takes precedence over the plaintext demo password.
DEMO_PASSWORD_HASH=
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
